# The Python sensor. Kept as the reference implementation and as the differential oracle for the
# sensor's test suite; `maltrail-sensor.service` runs the current sensor. See
# sensor/docs/INSTALL.md for the migration.
[Unit]
Description=Maltrail. OLD (Python) sensor of malicious traffic detection system
Documentation=https://github.com/stamparm/maltrail#readme
Documentation=https://github.com/stamparm/maltrail/wiki
Requires=network.target
Wants=maltrail-server.service
After=network-online.target maltrail-server.service

[Service]
User=root
WorkingDirectory=/opt/maltrail/
ExecStart=/usr/bin/python3 old/sensor.py
KillMode=mixed

[Install]
WantedBy=multi-user.target
